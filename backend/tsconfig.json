{
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": ".",
    "allowJs": true,
    "moduleDetection": "force",
    "noEmit": true
  },
  "include": ["./**/*"],
  "exclude": ["node_modules", "dist"]
}
